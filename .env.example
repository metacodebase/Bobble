# Prefer controlling API hosts in src/config/urls.js (USE_PROD + URLS).
# Optional override below wins over urls.js when set.
#
# Local backend:
# EXPO_PUBLIC_API_URL=http://localhost:8000
# Physical device (LAN): http://YOUR_MAC_LAN_IP:8000
# AWS production API:
# EXPO_PUBLIC_API_URL=http://34.204.180.53:8000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_APP_ENV=development

# Expo push tokens — free expo.dev project ID only (NOT EAS credentials upload).
# Run once: npm run setup:eas
# Local APK/IPA builds do NOT need eas credentials — see npm run android:apk / ios:archive
EXPO_PUBLIC_EAS_PROJECT_ID=

# Google Sign-In client IDs (Firebase project bobble-6b0c0)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1028741562392-cg69nc8g5s7pnpsed7hkrvimp98f5f84.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1028741562392-ft0clsr5be90t7ovclfb64uffcu1qrqc.apps.googleusercontent.com
#
# Android also needs the signing certificate SHA-1 in Firebase (not just env vars):
# 1. Firebase Console → Project settings → Your apps → Android (com.metacodebase.Bobble)
# 2. Add SHA-1 (+ SHA-256). Local debug builds (expo prebuild / expo run:android):
#    cd android && ./gradlew signingReport
#    (uses android/app/debug.keystore — not ~/.android/debug.keystore)
# 3. EAS / Play Store builds: add SHA-1 from eas credentials or Play Console app signing
# 4. Download the updated google-services.json, replace ./google-services.json, rebuild
