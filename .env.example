# Prefer controlling API hosts in src/config/urls.js (USE_PROD + URLS).
# Optional override below wins over urls.js when set.
#
# Local backend:
# EXPO_PUBLIC_API_URL=http://localhost:8000
# Physical device (LAN): http://YOUR_MAC_LAN_IP:8000
# AWS production API:
# EXPO_PUBLIC_API_URL=http://34.204.180.53:8000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SHARE_URL=https://bobble.au
EXPO_PUBLIC_APP_ENV=development

# Expo push tokens — free expo.dev project ID only (NOT EAS credentials upload).
# Run once: npm run setup:eas
# Local APK/IPA builds do NOT need eas credentials — see npm run android:apk / ios:archive
EXPO_PUBLIC_EAS_PROJECT_ID=

# Google Sign-In client IDs (Firebase project bobble-6b0c0)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1028741562392-cg69nc8g5s7pnpsed7hkrvimp98f5f84.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1028741562392-ft0clsr5be90t7ovclfb64uffcu1qrqc.apps.googleusercontent.com

# RevenueCat public SDK keys (Project settings → API keys). Never put the secret REST key here.
# Products: bobble_pro_monthly / bobble_pro_annual · Entitlement: bobble_pro · Offering: default
# Play base plans (one each): monthly / annual → RC Android IDs bobble_pro_monthly:monthly,
# bobble_pro_annual:annual. RC Android app setting: "Only Android SDK v6+".
# Test Store key (test_…) works on both platforms for sandbox without App Store / Play.
# Release builds ignore test_ keys — set platform keys for production.
EXPO_PUBLIC_RC_TEST_API_KEY=
EXPO_PUBLIC_RC_IOS_API_KEY=
EXPO_PUBLIC_RC_ANDROID_API_KEY=

# AdMob public app/ad-unit IDs. Development uses Google's sample IDs automatically.
# Create consent messages in AdMob Privacy & messaging before enabling production units.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-5338820225351889~9321573350
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-5338820225351889~1143700432
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-5338820225351889/5956352451
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-5338820225351889/2017107440
#
# Android package: com.bobble.au (must match Play Console + RevenueCat).
# Play Store AAB (internal/open testing): npm run android:aab
#   → android/app/build/outputs/bundle/release/app-release.aab
# Upload keystore lives in credentials/android/ (gitignored — back it up).
#
# Play subscriptions (long-term / Billing Library 5+):
# 1. Create bobble_pro_monthly + bobble_pro_annual (separate products, not multi-base-plan SKUs).
# 2. Each: one auto-renewing base plan (IDs monthly / annual), price, activate.
# 3. Optional 7-day free trial as an offer on that base plan.
# 4. Base plan ⋮ → "Use for deprecated billing methods" (safety net; app uses modern APIs).
# 5. RevenueCat → Android app → Product settings → "Only Android SDK v6+".
# 6. Import/create RC products as bobble_pro_monthly:monthly + bobble_pro_annual:annual;
#    attach to entitlement bobble_pro and offering default ($rc_monthly / $rc_annual).
#
# Android also needs the signing certificate SHA-1 in Firebase (not just env vars):
# 1. Firebase Console → Project settings → Your apps → Android (com.bobble.au)
# 2. Add SHA-1 (+ SHA-256). Local debug builds (expo prebuild / expo run:android):
#    cd android && ./gradlew signingReport
#    (uses android/app/debug.keystore — not ~/.android/debug.keystore)
# 3. Play Store / AAB builds: SHA from credentials/android/bobble-upload.keystore
#    keytool -list -v -keystore credentials/android/bobble-upload.keystore -alias bobble-upload
# 4. After Play App Signing is on, also add the App signing key SHA-1 from
#    Play Console → App integrity (Google may re-sign the installable APK)
# 5. Download the updated google-services.json, replace ./google-services.json, rebuild
