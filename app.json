{
  "expo": {
    "name": "Bobble",
    "slug": "Bobble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/bobble-app-icon.png",
    "scheme": "bobble",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bobble.au",
      "associatedDomains": ["applinks:bobble.au", "applinks:www.bobble.au"],
      "buildNumber": "7",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Bobble uses your microphone to record voice memos and show a live waveform while you speak.",
        "NSPhotoLibraryUsageDescription": "Bobble uses your photo library so you can choose a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Bobble saves achievement cards to your photo library when you tap Save to Photos.",
        "NSCameraUsageDescription": "Bobble uses your camera so you can take a profile picture.",
        "NSCalendarsUsageDescription": "Bobble uses your calendar to sync tasks and events from your Bobbles.",
        "NSCalendarsFullAccessUsageDescription": "Bobble uses your calendar to sync tasks and events from your Bobbles.",
        "NSRemindersUsageDescription": "Bobble uses your reminders to sync tasks from your Bobbles.",
        "NSRemindersFullAccessUsageDescription": "Bobble uses your reminders to sync tasks from your Bobbles.",
        "NSUserNotificationsUsageDescription": "Bobble sends task reminders and streak alerts.",
        "UIBackgroundModes": ["remote-notification"],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "34.204.180.53": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "appleTeamId": "BNV5TR576V",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.bobble.au"]
      }
    },
    "android": {
      "icon": "./src/assets/images/bobble-app-icon.png",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png",
        "backgroundColor": "#A485FA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bobble.au",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bobble.au",
              "pathPrefix": "/share"
            },
            {
              "scheme": "https",
              "host": "bobble.au",
              "pathPrefix": "/bobble"
            },
            {
              "scheme": "https",
              "host": "www.bobble.au",
              "pathPrefix": "/share"
            },
            {
              "scheme": "https",
              "host": "www.bobble.au",
              "pathPrefix": "/bobble"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/bobble-main.png"
    },
    "plugins": [
      "./plugins/with-bobble-ios-privacy.js",
      "./plugins/with-bobble-native-splash.js",
      "./plugins/with-android-purchase-launch-mode.js",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "fonts": ["./node_modules/@expo-google-fonts/sniglet/400Regular/Sniglet_400Regular.ttf"],
          "widgets": [
            {
              "name": "BobbleTasksSmall",
              "label": "Bobble Tasks",
              "description": "Small \u2014 today's count and Bobble mood (same as iOS).",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "none",
              "previewImage": "./src/assets/images/widget-preview-small.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "BobbleTasks",
              "label": "Bobble Tasks",
              "description": "Medium \u2014 tasks, next due, and Bobble mood (same as iOS).",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "none",
              "previewImage": "./src/assets/images/widget-preview-medium.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "barStyle": "light",
          "visibility": "visible"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-native.png",
          "resizeMode": "cover",
          "backgroundColor": "#FBFAFB",
          "ios": {
            "image": "./src/assets/images/splash-native.png",
            "resizeMode": "cover",
            "backgroundColor": "#FBFAFB",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./src/assets/images/splash-native.png",
            "resizeMode": "cover",
            "backgroundColor": "#FBFAFB"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bobble uses your microphone to record voice memos and show a live waveform while you speak."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bobble uses your photo library so you can choose a profile picture.",
          "cameraPermission": "Bobble uses your camera so you can take a profile picture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Bobble uses your photo library so you can choose a profile picture.",
          "savePhotosPermission": "Bobble saves achievement cards to your photo library when you tap Save to Photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Bobble uses your calendar to sync tasks and events from your Bobbles.",
          "remindersPermission": "Bobble uses your reminders to sync tasks from your Bobbles."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1028741562392-ft0clsr5be90t7ovclfb64uffcu1qrqc"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "buildReactNativeFromSource": true,
            "extraPods": [
              {
                "name": "AppCheckCore",
                "version": "11.2.0"
              }
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/bobble-app-icon.png",
          "color": "#A485FA",
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-share",
        {
          "ios": ["fb"],
          "android": ["com.facebook.katana"],
          "enableBase64ShareAndroid": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.bobble.au.widget",
                  "targetName": "BobbleWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.bobble.au"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "81e6a3de-e20f-4a4b-b6de-28e44527dd6c"
      },
      "router": {}
    }
  }
}
